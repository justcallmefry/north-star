# Aligned — iOS TestFlight pipeline.
# Runs entirely on GitHub's macOS runners; no local Mac required.
# Signing uses the App Store Connect API key + Xcode-managed (automatic)
# signing, so there's no certificates repo to maintain (no `match`).

require "base64"
require "shellwords"

default_platform(:ios)

PROJECT = "ios/App/App.xcodeproj"
SCHEME  = "App"

platform :ios do
  desc "Build the app and upload it to TestFlight"
  lane :beta do
    # Accept the .p8 either as raw PEM or base64-encoded. Getting this
    # wrong is the most common setup mistake, and the failure it produces
    # (OpenSSL: "string contains null byte") names nothing useful — the
    # base64 flag makes fastlane decode an already-plain PEM into garbage.
    key_content = ENV.fetch("ASC_KEY_CONTENT").strip
    key_is_pem  = key_content.include?("BEGIN PRIVATE KEY")
    key_pem     = key_is_pem ? key_content : (Base64.decode64(key_content) rescue "")

    unless key_pem.include?("BEGIN PRIVATE KEY")
      UI.user_error!(
        "ASC_KEY_CONTENT is neither a .p8 private key nor valid base64 of one. " +
        "Re-create the secret from the raw file; a correct value starts with LS0tLS1CRUdJTi"
      )
    end

    key_id    = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: !key_is_pem
    )

    # Force Xcode-managed signing and stamp the team so the API key can
    # create/download the distribution profile during the archive.
    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: true,
      team_id: ENV.fetch("APPLE_TEAM_ID")
    )

    # Every upload needs a unique, increasing build number. CI run number
    # is monotonic and needs no network round-trip.
    increment_build_number(
      xcodeproj: PROJECT,
      build_number: ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    )

    # xcodebuild is a separate process from fastlane and does not inherit
    # the API key above — without credentials of its own it reports "No
    # Accounts" and cannot mint a profile, even with
    # -allowProvisioningUpdates. Hand it the key explicitly. Written to
    # disk because the flag takes a path, and removed in the ensure below.
    key_path = File.expand_path("fastlane/.asc_key.p8")
    File.write(key_path, key_pem)

    begin
      build_app(
        # Capacitor 8 uses Swift Package Manager, not CocoaPods, so no
        # .xcworkspace is ever generated — the .xcodeproj is the build unit.
        project: PROJECT,
        scheme: SCHEME,
        export_method: "app-store",
        xcargs: [
          "-allowProvisioningUpdates",
          "-authenticationKeyPath #{key_path.shellescape}",
          "-authenticationKeyID #{key_id.shellescape}",
          "-authenticationKeyIssuerID #{issuer_id.shellescape}"
        ].join(" "),
        output_directory: "build",
        clean: true
      )
    ensure
      File.delete(key_path) if File.exist?(key_path)
    end

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true, # don't burn runner minutes waiting on Apple
      skip_submission: true                    # lands in TestFlight, not App Store review
    )
  end
end
