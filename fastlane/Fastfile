# Aligned — iOS TestFlight pipeline.
# Runs entirely on GitHub's macOS runners; no local Mac required.
#
# Signing is MANUAL, using an App Store distribution certificate and
# provisioning profile fetched with the App Store Connect API key.
#
# Xcode's automatic signing was tried first and cannot work here: headless,
# it still tries to establish a *development* identity for the machine
# ("Revoke certificate: ... its private key is not installed in your
# keychain") and then looks for a development provisioning profile, which
# requires a registered device no CI runner has. That happens even with
# -allowProvisioningUpdates, an authentication key, CODE_SIGN_IDENTITY
# cleared, and -configuration Release — all verified in the build log.

require "base64"
require "tmpdir"
require "spaceship"

default_platform(:ios)

PROJECT   = "ios/App/App.xcodeproj"
SCHEME    = "App"
BUNDLE_ID = "com.alignedconnectingcouples.app"

platform :ios do
  desc "Build the app and upload it to TestFlight"
  lane :beta do
    # Accept the .p8 either as raw PEM or base64-encoded. Getting this
    # wrong is the most common setup mistake, and the failure it produces
    # (OpenSSL: "string contains null byte") names nothing useful — the
    # base64 flag makes fastlane decode an already-plain PEM into garbage.
    key_content = ENV.fetch("ASC_KEY_CONTENT").strip
    key_is_pem  = key_content.include?("BEGIN PRIVATE KEY")
    key_pem     = key_is_pem ? key_content : (Base64.decode64(key_content) rescue "")

    unless key_pem.include?("BEGIN PRIVATE KEY")
      UI.user_error!(
        "ASC_KEY_CONTENT is neither a .p8 private key nor valid base64 of one. " +
        "Re-create the secret from the raw file; a correct value starts with LS0tLS1CRUdJTi"
      )
    end

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: key_content,
      is_key_content_base64: !key_is_pem
    )

    # Temporary keychain for the certificate; a runner has no unlocked
    # login keychain to import into.
    setup_ci

    # cert() defaults to the *login* keychain, but setup_ci built a
    # separate temporary one — so without an explicit keychain_path the
    # certificate and the WWDR intermediate land in different keychains
    # and cert()'s own verification fails with "Could not find the newly
    # generated certificate installed".
    keychain_name     = ENV["MATCH_KEYCHAIN_NAME"] || "fastlane_tmp_keychain"
    keychain_password = ENV["MATCH_KEYCHAIN_PASSWORD"] || ""
    keychain_path     = File.expand_path("~/Library/Keychains/#{keychain_name}-db")

    # A fresh keychain has none of Apple's intermediates, so a leaf
    # certificate imported into it chains to nothing and is not reported
    # as a usable signing identity.
    wwdr_path = File.join(Dir.tmpdir, "AppleWWDRCAG3.cer")
    sh("curl -fsSL -o #{wwdr_path} https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer")
    import_certificate(
      certificate_path: wwdr_path,
      keychain_name: keychain_name,
      keychain_password: keychain_password
    )

    # Apple allows only two distribution certificates and an ephemeral
    # runner never holds the private key of an existing one, so calling
    # cert() every build exhausts the quota after two runs. Prefer a
    # credential supplied as a secret.
    #
    # Careful: what cert() writes as "<id>.p12" is NOT a PKCS#12 bundle —
    # fastlane dumps the raw private key PEM into that filename. Importing
    # it alone yields a key with no certificate, which macOS does not
    # report as a signing identity at all ("0 valid identities found").
    # So when the secret holds a bare key, fetch its certificate from
    # Apple and assemble a real PKCS#12 from the pair.
    stored = ENV["DIST_CERT_P12_BASE64"].to_s.strip
    if stored.empty?
      UI.important("No DIST_CERT_P12_BASE64 secret — creating a new distribution certificate. " +
                   "This consumes one of Apple's two slots; see docs/ios-deploy.md.")
      cert(
        api_key: api_key,
        development: false,
        keychain_path: keychain_path,
        keychain_password: keychain_password,
        output_path: "fastlane/certs"
      )
    else
      decoded = Base64.decode64(stored)
      is_bare_key = decoded.include?("PRIVATE KEY") && !decoded.include?("BEGIN CERTIFICATE")
      UI.message("Stored credential looks like #{is_bare_key ? 'a private key (will pair it with the certificate from Apple)' : 'a PKCS#12 bundle'}")

      import_path = File.join(Dir.tmpdir, "identity.p12")

      if is_bare_key
        Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
          key_id: key_id, issuer_id: issuer_id, key: key_pem
        )
        distribution = Spaceship::ConnectAPI::Certificate.all.find do |c|
          c.certificate_type.to_s.include?("DISTRIBUTION")
        end
        UI.user_error!("The stored key has no distribution certificate on the account to pair with.") unless distribution
        UI.message("Pairing stored key with certificate #{distribution.id}")

        key_file = File.join(Dir.tmpdir, "dist_key.pem")
        der_file = File.join(Dir.tmpdir, "dist_cert.der")
        pem_file = File.join(Dir.tmpdir, "dist_cert.pem")
        File.write(key_file, decoded)
        File.write(der_file, Base64.decode64(distribution.certificate_content))
        sh("openssl x509 -inform DER -in #{der_file} -out #{pem_file}")
        # -legacy: macOS keychain cannot read OpenSSL 3's default PBES2 p12.
        sh("openssl pkcs12 -export -legacy -inkey #{key_file} -in #{pem_file} -out #{import_path} -passout pass:")
        [key_file, der_file, pem_file].each { |f| File.delete(f) if File.exist?(f) }
        cert_password = ""
      else
        File.write(import_path, decoded)
        cert_password = ENV["DIST_CERT_P12_PASSWORD"].to_s
      end

      import_certificate(
        certificate_path: import_path,
        certificate_password: cert_password,
        keychain_name: keychain_name,
        keychain_password: keychain_password
      )
      File.delete(import_path) if File.exist?(import_path)
    end

    # An imported .p12 is not automatically a usable *signing identity*:
    # the keychain has to be in the user search list, unlocked, and carry a
    # partition list that lets codesign use the private key non-
    # interactively. Without this the certificate is present but sigh
    # reports it as "not available locally" and finds no AppStore identity.
    sh("security list-keychains -d user -s \"#{keychain_path}\" login.keychain-db")
    sh("security unlock-keychain -p \"#{keychain_password}\" \"#{keychain_path}\"")
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k \"#{keychain_password}\" \"#{keychain_path}\" > /dev/null 2>&1 || true")

    # Diagnostic: prints the identities codesign can actually see.
    sh("security find-identity -v -p codesigning \"#{keychain_path}\" || true")

    # App Store provisioning profile for this bundle id. Needs no
    # registered devices, which is the whole point.
    sigh(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      development: false
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: BUNDLE_ID
    )

    # Every upload needs a unique, increasing build number. CI run number
    # is monotonic and needs no network round-trip.
    increment_build_number(
      xcodeproj: PROJECT,
      build_number: ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    )

    build_app(
      # Capacitor 8 uses Swift Package Manager, not CocoaPods, so no
      # .xcworkspace is ever generated — the .xcodeproj is the build unit.
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { BUNDLE_ID => profile_name }
      },
      output_directory: "build",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true, # don't burn runner minutes waiting on Apple
      skip_submission: true                    # lands in TestFlight, not App Store review
    )
  end
end
